{
  "name": "tarang-rian",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5"
    }
  },
  "type": "module",
  "scripts": {
    "check": "oxfmt --config oxfmt.config.ts --check . && oxlint --config oxlint.config.ts .",
    "fix": "oxfmt --config oxfmt.config.ts --write . && oxlint --config oxlint.config.ts --fix .",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "deploy:web": "turbo run deploy -F web"
  },
  "dependencies": {
    "@tarang-rian/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@tarang-rian/config": "workspace:*",
    "@types/node": "^22.13.14",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "ultracite": "7.9.4",
    "wrangler": "^4.54.0"
  },
  "packageManager": "bun@1.3.5"
}
