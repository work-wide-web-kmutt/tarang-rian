{
  "name": "tarang-rian",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5"
    }
  },
  "type": "module",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix && bun run fix:canonical",
    "fix:canonical": "eslint apps/web/src --fix",
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "deploy:web": "turbo run deploy -F web"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@tarang-rian/env": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@commitlint/cli": "^20.3.0",
    "@commitlint/config-conventional": "^20.3.0",
    "@tarang-rian/config": "workspace:*",
    "eslint": "^9.39.2",
    "eslint-plugin-tailwind-canonical-classes": "^1.1.0",
    "lefthook": "^2.1.10",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "typescript-eslint": "^8.53.0",
    "ultracite": "7.0.11",
    "wrangler": "^4.54.0"
  },
  "packageManager": "bun@1.3.5"
}
